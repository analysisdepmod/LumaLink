{
  "name": "griddata.client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "asbuild": "asc assembly/ldpcbp.ts --config asconfig.json --target release",
    "simdbuild": "asc assembly/spatialSimd.ts --outFile src/services/spatialSimd.wasm --runtime stub --optimizeLevel 3 --shrinkLevel 0 --noAssert --enable simd",
    "build": "npm run asbuild && npm run simdbuild && tsc -b && vite build",
    "test": "npx --yes tsx --test tests/protocol.test.ts tests/codecLab.test.ts",
    "lab": "npx --yes tsx scripts/codecLab.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@msgpack/msgpack": "^3.1.3",
    "antd": "^5.24.7",
    "pako": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@assemblyscript/loader": "^0.28.20",
    "@types/node": "^26.2.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "assemblyscript": "^0.28.20",
    "eslint": "^10.8.1",
    "typescript": "~5.7.0",
    "vite": "^6.3.0"
  }
}
